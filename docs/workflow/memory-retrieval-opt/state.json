  "risks": [
    {
      "id": "R-1",
      "desc": "切换嵌入模型致向量维度变化,存量向量全部失效;重建过程失败/超时会留下半重建状态(即当前 9/24 缺口的根因)",
      "prob": "中",
      "impact": "高",
      "mitigation": "重建改为原子化(先写临时集合成功后原子替换)或对账自愈+断点续跑;切换前自动备份",
      "status": "open"
    },
    {
      "id": "R-2",
      "desc": "相似度阈值过高导致真正相关的长尾查询被过滤,召回率反降",
